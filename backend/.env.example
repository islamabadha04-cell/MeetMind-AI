# Environment Configuration for Smart Noter 2027
PROJECT_NAME="Smart Noter AI — Meeting Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite file database. For PostgreSQL use: postgresql+psycopg2://user:password@localhost:5432/smartnoter
DATABASE_URL="sqlite:///./smart_noter.db"

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=100

# Pluggable AI Services (Optional / Fallback provided)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
WHISPER_MODEL="base"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://192.168.140.112:8080"]
